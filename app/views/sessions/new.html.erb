<%= render layout: 'shared/auth_layout', locals: { title: 'Sign in', subtitle: '' } do %>
  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= render "shared/input_field",
      form: form,
      field_type: "email",
      field_name: :email_address,
      placeholder: "Enter your email address",
      required: true,
      autofocus: true,
      autocomplete: "username",
      value: params[:email_address] %>
    </div>

    <div class="my-5">
      <%= render "shared/input_field",
      form: form,
      field_type: "password",
      field_name: :password,
      placeholder: "Enter your password",
      required: true,
      autocomplete: "current-password" %>
    </div>

    <div
      class="
        flex flex-col sm:flex-row justify-center sm:justify-between items-center gap-4
      "
    >
      <button type="submit">
        <%= render "shared/aqua_style", text: "Sign in" %>
      </button>
    </div>
  <% end %>
<% end %>

