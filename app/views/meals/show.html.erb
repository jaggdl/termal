<div class="space-y-6">
  <%= render partial: "shared/back_button" %>

  <div class="flex gap-6 flex-col md:flex-row items-center md:items-start">
    <div class="round w-72 min-w-72 max-w-72 bg-gray-200">
      <% if @meal.image.attached? %>
        <%= image_tag @meal.image.variant(resize_to_limit: [576, 576]),
        class: "w-full h-full object-cover" %>
      <% else %>
        <div class="w-full h-72 flex items-center justify-center">
          <%= heroicon "photo", options: { class: "h-20 w-20 text-gray-400" } %>
        </div>
      <% end %>
    </div>

    <div class="w-full">
      <div class="inline">
        <h1 class="text-2xl font-bold text-gray-800 mb-2"><%= @meal.meal_name %></h1>
      </div>

      <% if @meal.description.present? %>
        <div class="text-gray-600 text-sm">
          <%= @meal.description %>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <% ["calories", "fats", "proteins", "carbs", "fiber", "sodium", "sugar", "cholesterol"].each do |attr| %>
          <div class="flex items-center justify-between">
            <span class="font-semibold text-gray-700"><%= attr.humanize %>:</span>
            <span><%= @meal[attr] %></span>
          </div>
        <% end %>

      </div>

      <div class="mt-6 flex justify-end gap-x-4">
        <button>Add</button>
      </div>
    </div>
  </div>
</div>
