<div class="space-y-6">
  <%= render partial: "shared/back_button" %>

  <%= render partial: "shared/meal_details", locals: { meal: @meal, user_profile: @user_profile } %>
  
  <div class="mt-6 flex justify-end gap-x-4">
    <%= link_to edit_meal_path(@meal) do %>
      <%= render "shared/aqua_style",
      text: "Edit meal",
      variant: "secondary",
      icon: "pencil" %>
    <% end %>
  </div>
</div>