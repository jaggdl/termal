<% 
  # Set page title and OpenGraph metadata
  content_for :title, @meal.meal_name
  
  meal_og_url = meal_og_image_url(@meal.id, format: :png)
  meal_description = @meal.description.present? ? @meal.description : "#{@meal.calories} calories, #{@meal.proteins}g protein, #{@meal.fats}g fat, #{@meal.carbs}g carbs"
  
  content_for :meta_tags do
    meta_og_tags(
      title: @meal.meal_name,
      description: meal_description,
      image: meal_og_url
    )
  end
%>

<div class="max-w-xl mx-auto bg-white shadow-md rounded-lg p-6 space-y-6">
  <%= link_to "Back", root_path, class: "text-blue-600 hover:underline" %>
  <% if @meal.image.attached? %>
    <%= image_tag @meal.image.variant(resize_to_limit: [1056, 1056]), class: "round w-full object-cover" %>
  <% else %>
    <span class="text-muted">No Image</span>
  <% end %>

  <h1 class="text-2xl font-bold text-gray-800"><%= @meal.meal_name %></h1>

  <%= form_with model: @meal, url: meal_path(@meal), method: :patch, class: "space-y-4", data: { controller: "datetime-sync", "datetime-sync-timezone": Current.user_profile.timezone } do |f| %>
    <div class="grid grid-cols-2 gap-4">
      <div class="col-span-2 flex items-center justify-between">
        <span class="font-semibold text-gray-700">Created At:</span>
        <span class="font-semibold text-gray-700"><%= @meal.created_at_in_timezone.strftime("%I:%M %p") %></span>
      </div>

      <% ["calories", "fats", "proteins", "carbs", "fiber", "sodium", "sugar", "cholesterol"].each do |attr| %>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-gray-700"><%= attr.humanize %>:</span>
          <%= f.text_field attr, class: "border border-gray-300 p-1 rounded w-16 text-center" %>
        </div>
      <% end %>

    </div>

    <div class="mt-6 flex justify-between">
      <%= f.submit "Save Changes", class: "bg-blue-600 text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700" %>
    </div>

    <div class="flex gap-2">
      <%= link_to 'Destroy', meal_path(@meal), class: 'btn btn-sm btn-outline-danger', data: { turbo_method: "delete", turbo_confirm: "Are you sure?" } %>
    </div>

  <% end %>
</div>
