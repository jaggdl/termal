<%= turbo_stream_from Current.user, "meals" %>

<div class="flex flex-col w-full space-y-6">
  <div class="w-full flex justify-end">
    <%= link_to 'New Meal', new_meal_path, class: 'btn btn-primary' %>
  </div>

  <div class="flex w-full flex-col space-y-8">
    <% @meals_by_day.each do |date, meals| %>
      <div class="w-full">

        <div class="flex justify-between items-end">
          <h2 class="mb-4 font-semibold">
            <% 
              today = Date.today
              yesterday = today - 1.day
              date_string = case date
              when today
                "Today"
              when yesterday
                "Yesterday"
              else
                date.strftime("%B %d, %Y")
              end
            %>
            <%= date_string %>
          </h2>

          <div class="flex space-x-4">
            <%= render partial: 'shared/nutrient_meter', locals: { meals: meals, unit: 'calories', base_number: 3000 } %>
            <%= render partial: 'shared/nutrient_meter', locals: { meals: meals, unit: 'proteins', base_number: 136 } %>
          </div>
        </div>

        <ul>
          <% meals.each do |meal| %>
            <%= render meal %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
