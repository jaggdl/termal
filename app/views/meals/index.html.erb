<div class="flex flex-col w-full space-y-6">

  <div class="w-full flex justify-between">
    <h1 class="font-bold text-xl">Meals</h1>

    <%= link_to 'New Meal', new_meal_path, class: 'btn btn-primary' %>
  </div>

  <div class="flex w-full flex-col space-y-8">
    <% @meals_by_day.each do |date, meals| %>
      <div class="w-full">

        <div class="flex justify-between items-end">
          <h2 class="mb-4 font-semibold">
            <% 
              today = Date.today
              yesterday = today - 1.day
              date_string = case date
              when today
                "Today"
              when yesterday
                "Yesterday"
              else
                date.strftime("%B %d, %Y")
              end
            %>
            <%= date_string %>
          </h2>

          <div class="flex space-x-4">
            <%= render partial: 'shared/nutrient_meter', locals: { meals: meals, unit: 'calories', base_number: 3000 } %>
            <%= render partial: 'shared/nutrient_meter', locals: { meals: meals, unit: 'proteins', base_number: 136 } %>
          </div>
        </div>

        <ul>
          <% meals.each do |meal| %>
            <li class="flex justify-between items-center">
              <div class="flex items-center gap-x-4">
                <%= link_to meal_path(meal) do %>
                  <% if meal.image.attached? %>
                    <%= image_tag meal.image.variant(resize_to_limit: [320, 320]), class: "round w-32 h-32 object-cover" %>
                  <% else %>
                    <span class="text-muted">No Image</span>
                  <% end %>
                <% end %>
                <div class="flex flex-col">
                  <%= link_to meal.meal_name, meal_path(meal), class: 'text-lg' %>
                  <span class="text-sm"><%= meal.consumed_at_in_timezone(@timezone).strftime("%I:%M %p") %></span>
                </div>
              </div>
              <div class="flex space-x-2">
                <% nutrient_keys = ['calories', 'fats', 'proteins', 'carbs'] %>
                <% nutrient_keys.each do |key| %>
                  <div class="text-sm flex flex-col w-10 text-right">
                    <span class="font-semibold"><%= meal[key] %></span>
                    <span class="text-gray-500"><%= key[0, 3] %></span>
                  </div>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
