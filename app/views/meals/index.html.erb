<h1 class="mb-4">Meals</h1>

<table class="table table-striped table-bordered">
  <thead class="thead-dark">
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Consumed At</th>
      <th>Calories</th>
      <th>Fats</th>
      <th>Proteins</th>
      <th>Carbs</th> <!-- New -->
      <th>Fiber</th> <!-- New -->
      <th>Sodium</th> <!-- New -->
      <th>Sugar</th> <!-- New -->
      <th>Cholesterol</th> <!-- New -->
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @meals.each do |meal| %>
      <tr>
        <td class="text-center">
          <% if meal.image.attached? %>
            <%= image_tag meal.image.variant(resize_to_limit: [80, 80]), class: "rounded img-thumbnail" %>
          <% else %>
            <span class="text-muted">No Image</span>
          <% end %>
        </td>
        <td><%= meal.meal_name %></td>
        <td><%= meal.consumed_at.strftime("%B %d, %Y at %I:%M %p") %></td>
        <td><%= meal.calories %> kcal</td>
        <td><%= meal.fats %> g</td>
        <td><%= meal.proteins %> g</td>
        <td><%= meal.carbs %> g</td> <!-- New -->
        <td><%= meal.fiber %> g</td> <!-- New -->
        <td><%= meal.sodium %> mg</td> <!-- New -->
        <td><%= meal.sugar %> g</td> <!-- New -->
        <td><%= meal.cholesterol %> mg</td> <!-- New -->
        <td class="d-flex gap-2">
          <%= link_to 'Show', meal_path(meal), class: 'btn btn-sm btn-outline-info' %>
          <%= button_to 'Destroy', meal_path(meal), method: :delete, class: 'btn btn-sm btn-outline-danger', data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-3">
  <%= link_to 'New Meal', new_meal_path, class: 'btn btn-primary' %>
</div>
