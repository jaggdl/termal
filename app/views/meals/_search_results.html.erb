<turbo-frame id="search_results">
<% if meals.any? %>
  <ul class="absolute top-12 shadow-lg bg-white/80 z-10 backdrop-blur-lg w-full p-2">
    <% meals.each do |meal| %>
      <li class="flex gap-x-4 items-center w-full justify-between">
        <div class="flex gap-x-2 items-center">
          <%= link_to meal_path(meal) do %>
            <%= meal_image_tag(meal, size: :small) %>
          <% end %>
          <div class="flex flex-col">
            <span><%= meal.meal_name %></span>
            <%= render partial: 'meals/nutrients_table', locals: { meal: meal } %>
          </div>
        </div>
        <%= button_to user_meals_path, params: { meal_id: meal.id, date: date }, method: :post, data: { turbo: true } do %>
          <%= render 'shared/aqua_style', text: 'Add' %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
</turbo-frame>
