<li class="flex space-x-4 items-center">
  <div class="flex items-center">
    <%= link_to meal_path(meal) do %>
      <%= image_tag meal.image.variant(resize_to_limit: [320, 320]), class: "round w-32 h-32 object-cover" %>
    <% end %>
  </div>

  <%= render partial: 'meals/meal_info', locals: { meal: meal } %>
</li>
