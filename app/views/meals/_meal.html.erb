<li class="flex gap-x-4 items-center">
    <%= link_to meal_path(meal) do %>
      <div class="md:max-w-32 md:max-h-32 md:min-w-32 md:min-h-32 min-w-24 min-h-24 max-w-24 max-h-24">
        <% if meal.image.attached? %>
          <%= image_tag meal.image.variant(resize_to_limit: [256, 256]), 
            class: "w-full h-full object-cover bg-gray-200" %>
        <% else %>
          <div class="w-full h-full bg-gray-200 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 1.515a3 3 0 0 0-3 0L3 5.845a3 3 0 0 0-1.5 2.598m9 4.114 9-5.19V19.5a3 3 0 0 1-1.5 2.598l-7.5 4.33a3 3 0 0 1-3 0l-7.5-4.33A3 3 0 0 1 0 19.5v-9.457l9 5.19Zm0 0V7.847" />
            </svg>
          </div>
        <% end %>
      </div>
    <% end %>

  <%= render partial: 'meals/meal_info', locals: { meal: meal } %>
</li>
