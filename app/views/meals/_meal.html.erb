<li class="flex gap-x-4 items-center">
    <%= link_to meal_path(meal) do %>
      <div class="md:max-w-32 md:max-h-32 md:min-w-32 md:min-h-32 min-w-24 min-h-24 max-w-24 max-h-24">
        <% if meal.image.attached? %>
          <%= image_tag meal.image.variant(resize_to_limit: [256, 256]), 
            class: "w-full h-full object-cover bg-gray-200 dark:bg-gray-700" %>
        <% else %>
          <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
            <%= heroicon "cube", options: { class: "h-10 w-10 text-gray-400 dark:text-gray-500" } %>
          </div>
        <% end %>
      </div>
    <% end %>

  <%= render partial: 'meals/meal_info', locals: { meal: meal } %>
</li>
