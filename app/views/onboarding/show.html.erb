<%= render layout: 'shared/auth_layout', locals: { title: 'Welcome!', subtitle: '' } do %>
  <%= form_with url: onboarding_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= render 'shared/input_field', 
          form: form, 
          field_type: 'email', 
          field_name: :email_address, 
          placeholder: 'Enter your email address', 
          required: true, 
          autofocus: true, 
          autocomplete: 'username', 
          value: params[:email_address] %>
    </div>

    <div class="my-5">
      <%= render 'shared/input_field', 
          form: form, 
          field_type: 'password', 
          field_name: :password, 
          placeholder: 'Enter your password', 
          required: true, 
          autocomplete: 'current-password' %>
    </div>

    <div class="flex justify-center">
      <button type="submit">
        <%= render "shared/aqua_style", text: "Sign in" %>
      </button>
    </div>
  <% end %>
<% end %>