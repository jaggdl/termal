<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Calories Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <% if Rails.configuration.respond_to?(:x) && Rails.configuration.x.respond_to?(:vapid) && Rails.configuration.x.vapid[:public_key] %>
      <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid[:public_key] %>
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        document.cookie = `timezone=${timezone}; path=/`;
      });
    </script>
  </head>

  <body>
    <main class="container mx-auto md:mt-20 mt-6 px-5 mb-8 flex flex-col font-mono max-w-4xl">
      <% if Current.user %>
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8 text-gray-600 items-end mb-4">
        <%= link_to 'Meals', root_path, class: "#{current_page?(root_path) || request.path.start_with?('/user_meals') ? 'font-bold text-xl text-black' : ''}" %>
        <%= link_to 'Summary', nutrition_summary_path, class: "#{current_page?(nutrition_summary_path) ? 'font-bold text-xl text-black' : ''}" %>
        <%= link_to 'Analysis', analysis_path, class: "#{current_page?(analysis_path) ? 'font-bold text-xl text-black' : ''}" %>
        <div class="w-full flex justify-end items-center space-x-8">
          <% if Current.user&.can_invite? %>
            <%= link_to 'Family', family_path, class: "#{request.path.start_with?('/family') ? 'font-bold text-xl text-black' : ''}" %>
          <% end %>
          <%= link_to 'Profile', profile_path, class: "#{current_page?(profile_path) ? 'font-bold text-xl text-black' : ''}" %>
        </div>
      </nav>
      
      <!-- Mobile Navigation -->
      <nav class="md:hidden flex justify-between items-center mb-4">
        <div class="flex items-center">
          <%= link_to 'Meals', root_path, class: "mr-4 #{current_page?(root_path) || request.path.start_with?('/user_meals') ? 'font-bold text-black' : 'text-gray-600'}" %>
          <%= link_to 'Summary', nutrition_summary_path, class: "mr-4 #{current_page?(nutrition_summary_path) ? 'font-bold text-black' : 'text-gray-600'}" %>
          <%= link_to 'Analysis', analysis_path, class: "#{current_page?(analysis_path) ? 'font-bold text-black' : 'text-gray-600'}" %>
        </div>
        <div class="flex items-center space-x-4">
          <% if Current.user&.can_invite? %>
            <%= link_to 'Family', family_path, class: "#{request.path.start_with?('/family') ? 'font-bold text-black' : 'text-gray-600'}" %>
          <% end %>
          <%= link_to 'Profile', profile_path, class: "#{current_page?(profile_path) ? 'font-bold text-black' : 'text-gray-600'}" %>
        </div>
      </nav>
      <% end %>
      
      <div class="fixed z-50 top-4 left-0 right-0 pointer-events-none">
        <%= render "shared/flash", flash: flash %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
