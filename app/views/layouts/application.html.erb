<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Calories Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        document.cookie = `timezone=${timezone}; path=/`;
      });
    </script>
  </head>

  <body>
    <main class="container mx-auto md:mt-28 mt-12 px-5 flex flex-col font-mono max-w-4xl">
      <nav class="flex space-x-8 text-gray-600 items-end">
        <%= link_to 'Meals', root_path, class: "#{request.path.start_with?('/meals') || current_page?(root_path) ? 'font-bold text-xl text-black' : ''}" %>
        <%= link_to 'Profile', profile_path, class: "#{current_page?(profile_path) ? 'font-bold text-xl text-black' : ''}" %>
      </nav>
      <%= render "shared/flash_messages" %>
      <%= yield %>
    </main>
  </body>
</html>
