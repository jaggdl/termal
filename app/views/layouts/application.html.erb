<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Calories Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <% if Rails.configuration.respond_to?(:x) && Rails.configuration.x.respond_to?(:vapid) && Rails.configuration.x.vapid[:public_key] %>
      <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid[:public_key] %>
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        document.cookie = `timezone=${timezone}; path=/`;
      });
    </script>
  </head>

  <body>
    <main class="container mx-auto md:mt-20 mt-6 px-5 md:mb-8 mb-20 flex flex-col font-mono max-w-4xl">
      <% if authenticated? %>
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8 text-gray-600 items-end mb-4">
        <%= link_to 'Meals', root_path, class: "#{current_page?(root_path) || request.path.start_with?('/user_meals') ? 'font-bold text-xl text-black' : ''}" %>
        <%= link_to 'Summary', nutrition_summary_path, class: "#{current_page?(nutrition_summary_path) ? 'font-bold text-xl text-black' : ''}" %>
        <% if Current.user.is_admin? %>
          <%= link_to 'Analysis', analyses_path, class: "#{request.path.start_with?('/analysis') ? 'font-bold text-xl text-black' : ''}" %>
        <% end %>
        <div class="w-full flex justify-end items-center space-x-8">
          <% if Current.user.is_admin? %>
            <%= link_to 'Family', family_path, class: "#{request.path.start_with?('/family') ? 'font-bold text-xl text-black' : ''}" %>
          <% end %>
          <%= link_to 'Profile', profile_path, class: "#{current_page?(profile_path) ? 'font-bold text-xl text-black' : ''}" %>
        </div>
      </nav>
      
      <!-- Mobile Navigation -->
      <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white/80 backdrop-blur-sm border-t border-gray-200 flex justify-around items-center py-3 pb-[var(--nav-b-padding)] z-40" data-controller="pwa-detection">
        <%= link_to root_path, class: "flex flex-col items-center" do %>
          <%= heroicon "home", options: { class: "h-6 w-6 #{current_page?(root_path) || request.path.start_with?('/user_meals') ? 'text-sky-500' : 'text-gray-500'}" } %>
        <% end %>
        
        <%= link_to nutrition_summary_path, class: "flex flex-col items-center" do %>
          <%= heroicon "chart-bar", options: { class: "h-6 w-6 #{current_page?(nutrition_summary_path) ? 'text-sky-500' : 'text-gray-500'}" } %>
        <% end %>
        
        <% if Current.user.is_admin? %>
          <%= link_to analyses_path, class: "flex flex-col items-center" do %>
            <%= heroicon "magnifying-glass", options: { class: "h-6 w-6 #{request.path.start_with?('/analysis') ? 'text-sky-500' : 'text-gray-500'}" } %>
          <% end %>
        
          <%= link_to family_path, class: "flex flex-col items-center" do %>
            <%= heroicon "user-group", options: { class: "h-6 w-6 #{request.path.start_with?('/family') ? 'text-sky-500' : 'text-gray-500'}" } %>
          <% end %>
        <% end %>
        
        <%= link_to profile_path, class: "flex flex-col items-center" do %>
          <%= heroicon "user-circle", options: { class: "h-6 w-6 #{current_page?(profile_path) ? 'text-sky-500' : 'text-gray-500'}" } %>
        <% end %>
      </nav>
      <% end %>
      
      <div class="fixed z-50 top-4 left-0 right-0 pointer-events-none">
        <%= render "shared/flash", flash: flash %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
