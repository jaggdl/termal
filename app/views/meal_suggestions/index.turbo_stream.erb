<%= turbo_stream.update "meal-suggestions" do %>
  <div class="space-y-6">
    <h2 class="text-xl font-bold dark:text-dark-text mb-4">Meal Suggestions</h2>
    <% if @suggestion_set && @suggestion_set[:meal_sets] %>
      <% @suggestion_set[:meal_sets].each_with_index do |meal_set, index| %>
        <div class="mb-8">
          <h3 class="text-lg font-semibold dark:text-dark-text mb-2">
            Option
            <%= index + 1 %>:
            <span class="font-normal"><%= meal_set[:description] %></span>
          </h3>
          <%= render partial: "meal_suggestions/suggestion_set",
          locals: {
            meals: meal_set[:meals],
            date: @date,
          } %>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-600 dark:text-gray-400">
        No meal suggestions available. Try adjusting your daily targets or add
        more meals to the database.
      </p>
    <% end %>
  </div>
<% end %>

<%= turbo_stream.update "suggest-meals-button" do %>
<% end %>
