<%= turbo_stream.update "meal-suggestions" do %>
  <div class="space-y-6">
    <h2 class="text-xl font-bold dark:text-dark-text mb-4">Meal Suggestions</h2>
    <% @suggestion_sets.each do |set| %>
      <%= render partial: "meal_suggestions/suggestion_set",
                 locals: {
                   meals: set[:meals],
                   date: @date,
                   set_number: set[:set_number]
                 } %>
    <% end %>
  </div>
<% end %>
