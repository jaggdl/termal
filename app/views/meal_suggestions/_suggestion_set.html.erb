<% if meals.any? %>
  <div class="mb-6">
    <h3 class="text-lg font-semibold mb-3 dark:text-dark-text">
      Suggestion Set <%= set_number %>
    </h3>
    <%= render partial: "shared/meal_list", locals: { meals: meals, date: date } %>
  </div>
<% else %>
  <div class="mb-6">
    <p class="text-gray-600 dark:text-gray-400">
      No meal suggestions found for Set <%= set_number %>. Try adjusting your daily targets or add more meals to the database.
    </p>
  </div>
<% end %>
