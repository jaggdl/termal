<% if meals.any? %>
  <div class="mb-6">
    <%= render partial: "shared/meal_list", locals: { meals: meals, date: date } %>
  </div>
<% else %>
  <div class="mb-6">
    <p class="text-gray-600 dark:text-gray-400">
      No meal suggestions found. Try adjusting your daily targets or add more meals to the database.
    </p>
  </div>
<% end %>
