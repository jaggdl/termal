<div class="max-w-xl mx-auto space-y-6 py-6">
  <div class="mb-10 border-b border-gray-300 pb-6" data-controller="push-notifications">
    <h2 class="text-lg font-medium text-sky-700 mb-4">Notifications</h2>
    
    <div class="flex items-center justify-between">
      <div>
        <p class="font-medium text-gray-700">Push Notifications</p>
        <p class="text-sm text-gray-500" data-push-notifications-target="status"></p>
      </div>
      
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" 
               data-action="push-notifications#toggleSubscription" 
               data-push-notifications-target="subscribeButton"
               class="sr-only peer">
        <div class="w-14 h-7 bg-gray-200 rounded-full peer peer-focus:ring-2 peer-focus:ring-sky-300 
                    after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white 
                    after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all
                    peer-checked:after:translate-x-7 peer-checked:after:border-white 
                    peer-checked:bg-sky-400 shadow-lg blur-[0.5px] peer-checked:blur-[1px] peer-checked:shadow-sky-200
                    data-push-notifications-target='toggleSwitch'"></div>
      </label>
    </div>
  </div>

  <%= form_with model: @profile, url: profile_path(@profile), method: :patch, class: "space-y-6" do |f| %>
    <div class="">
      <h2 class="text-lg font-medium text-sky-700 mb-4">Personal Information</h2>
      
      <div class="grid gap-y-4">
        <div class="flex items-center justify-between">
          <label class="font-medium text-gray-700" for="user_profile_timezone">Timezone</label>
          <div class="w-2/3" data-controller="timezone">
            <%= f.select :timezone, 
              [], 
              { selected: @profile.timezone }, 
              class: "border border-gray-300 p-2 rounded-lg w-full focus:ring-2 focus:ring-sky-300 focus:border-sky-500 focus:outline-none",
              data: { 
                timezone_target: "select",
                selected: @profile.timezone
              }
            %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="font-medium text-gray-700" for="user_profile_age">Age</label>
          <div class="w-1/3">
            <%= f.number_field :age, class: "border border-gray-300 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 focus:border-sky-500 focus:outline-none" %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <span class="font-medium text-gray-700">Sex</span>
          <div class="w-2/3 flex space-x-6">
            <div class="flex items-center">
              <%= f.radio_button :sex, 'male', checked: (@profile.sex == 'male'), class: "h-4 w-4 text-sky-500 focus:ring-sky-400" %>
              <%= f.label :sex_male, 'Male', class: 'ml-2 text-gray-700' %>
            </div>
            <div class="flex items-center">
              <%= f.radio_button :sex, 'female', checked: (@profile.sex == 'female'), class: "h-4 w-4 text-sky-500 focus:ring-sky-400" %>
              <%= f.label :sex_female, 'Female', class: 'ml-2 text-gray-700' %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="font-medium text-gray-700" for="user_profile_weight">Weight (kg)</label>
          <div class="w-1/3">
            <%= f.number_field :weight, step: :any, class: "border border-gray-300 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 focus:border-sky-500 focus:outline-none" %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="font-medium text-gray-700" for="user_profile_height">Height (cm)</label>
          <div class="w-1/3">
            <%= f.number_field :height, step: :any, class: "border border-gray-300 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 focus:border-sky-500 focus:outline-none" %>
          </div>
        </div>
      </div>
    </div>

    <div class="">
      <h2 class="text-lg font-medium text-sky-700 mb-4">Fitness Goals</h2>

      <div class="space-y-5">
        <div>
          <p class="font-medium text-gray-700 mb-2">Physical Activity</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Sedentary', 'Lightly Active', 'Moderately Active', 'Very Active', 'Extremely Active'].each do |activity| %>
              <div class="flex items-center">
                <%= f.radio_button :physical_activity, activity.downcase.gsub(' ', '_'), 
                  checked: (@profile.physical_activity == activity.downcase.gsub(' ', '_')),
                  class: "h-4 w-4 text-sky-500 focus:ring-sky-400" %>
                <%= f.label :"physical_activity_#{activity.downcase.gsub(' ', '_')}", activity, class: "ml-2 text-gray-700" %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <p class="font-medium text-gray-700 mb-2">Weight Goals</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Lose Weight', 'Maintain', 'Gain Weight'].each do |goal| %>
              <div class="flex items-center">
                <%= f.radio_button :weight_goals, goal.downcase.gsub(' ', '_'), 
                  checked: (@profile.weight_goals == goal.downcase.gsub(' ', '_')),
                  class: "h-4 w-4 text-sky-500 focus:ring-sky-400" %>
                <%= f.label :"weight_goals_#{goal.downcase.gsub(' ', '_')}", goal, class: "ml-2 text-gray-700" %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <p class="font-medium text-gray-700 mb-2">Muscle Goals</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Build Muscle', 'Maintain Muscle'].each do |muscle| %>
              <div class="flex items-center">
                <%= f.radio_button :muscle_building, muscle.downcase.gsub(' ', '_'), 
                  checked: (@profile.muscle_building == muscle.downcase.gsub(' ', '_')),
                  class: "h-4 w-4 text-sky-500 focus:ring-sky-400" %>
                <%= f.label :"muscle_building_#{muscle.downcase.gsub(' ', '_')}", muscle, class: "ml-2 text-gray-700" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <button type="submit">
        <%= render 'shared/aqua_style', text: 'Save Profile' %>
      </button>
    </div>
  <% end %>

</div>
