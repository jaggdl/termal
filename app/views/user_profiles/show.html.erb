<div class="max-w-xl mx-auto space-y-6 py-6">
  <%= form_with model: @profile, url: profile_path(@profile), method: :patch, class: "space-y-6" do |f| %>
    <div class="mb-10 border-b border-gray-300 dark:border-gray-700 pb-6">
      <h2 class="text-lg font-medium text-sky-700 dark:text-sky-400 mb-4">Display & Notifications</h2>

      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="font-medium text-gray-700 dark:text-gray-300">Theme</p>
        </div>

        <div class="w-1/2">
          <select
            class="
              border border-gray-300 dark:border-gray-700 p-2 rounded-lg w-full focus:ring-2
              focus:ring-sky-300 dark:focus:ring-sky-700 focus:border-sky-500
              dark:focus:border-sky-700 focus:outline-none dark:bg-dark-surface
              dark:text-dark-text
            "
            data-theme-target="modeSelector"
            data-action="change->theme#changeMode"
          >
            <option value="system">System Default</option>
            <option value="light">Light Mode</option>
            <option value="dark">Dark Mode</option>
          </select>
        </div>
      </div>

      <div
        class="flex items-center justify-between"
        data-controller="push-notifications"
      >
        <div>
          <p class="font-medium text-gray-700 dark:text-gray-300">Push Notifications</p>
          <p
            class="text-sm text-gray-500 dark:text-gray-400"
            data-push-notifications-target="status"
          ></p>
        </div>

        <label class="relative inline-flex items-center cursor-pointer">
          <input
            type="checkbox"
            data-action="push-notifications#toggleSubscription"
            data-push-notifications-target="subscribeButton"
            class="sr-only peer"
          >
          <div
            class="
              w-14 h-7 bg-gray-200 dark:bg-gray-700 rounded-full peer peer-focus:ring-2
              peer-focus:ring-sky-300 dark:peer-focus:ring-sky-700 after:content-['']
              after:absolute after:top-0.5 after:left-0.5 after:bg-white
              dark:after:bg-gray-200 after:border-gray-300 dark:after:border-gray-600
              after:border after:rounded-full after:h-6 after:w-6 after:transition-all
              peer-checked:after:translate-x-7 peer-checked:after:border-white
              peer-checked:bg-sky-400 dark:peer-checked:bg-sky-600 shadow-lg blur-[0.5px]
              peer-checked:blur-[1px] peer-checked:shadow-sky-200
              dark:peer-checked:shadow-sky-900 data-push-notifications-target='toggleSwitch'
            "
          ></div>
        </label>
      </div>
    </div>
    <div class="">
      <h2 class="text-lg font-medium text-sky-700 dark:text-sky-400 mb-4">Personal Information</h2>

      <div class="grid gap-y-4">
        <div class="flex items-center justify-between">
          <label
            class="font-medium text-gray-700 dark:text-gray-300"
            for="user_profile_timezone"
          >Timezone</label>
          <div class="w-2/3" data-controller="timezone">
            <%= f.select :timezone,
                     [],
                     { selected: @profile.timezone },
                     class:
                       "border border-gray-300 dark:border-gray-700 p-2 rounded-lg w-full focus:ring-2 focus:ring-sky-300 dark:focus:ring-sky-700 focus:border-sky-500 dark:focus:border-sky-700 focus:outline-none dark:bg-dark-surface dark:text-dark-text",
                     data: {
                       timezone_target: "select",
                       selected: @profile.timezone,
                     } %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label
            class="font-medium text-gray-700 dark:text-gray-300"
            for="user_profile_age"
          >Age</label>
          <div class="w-1/3">
            <%= f.number_field :age,
                           class:
                             "border border-gray-300 dark:border-gray-700 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 dark:focus:ring-sky-700 focus:border-sky-500 dark:focus:border-sky-700 focus:outline-none dark:bg-dark-surface dark:text-dark-text" %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <span class="font-medium text-gray-700 dark:text-gray-300">Sex</span>
          <div class="w-2/3 flex space-x-6">
            <div class="flex items-center">
              <%= f.radio_button :sex,
                             "male",
                             checked: (@profile.sex == "male"),
                             class:
                               "h-4 w-4 text-sky-500 dark:text-sky-600 focus:ring-sky-400 dark:focus:ring-sky-700" %>
              <%= f.label :sex_male, "Male", class: "ml-2 text-gray-700 dark:text-gray-300" %>
            </div>
            <div class="flex items-center">
              <%= f.radio_button :sex,
                             "female",
                             checked: (@profile.sex == "female"),
                             class:
                               "h-4 w-4 text-sky-500 dark:text-sky-600 focus:ring-sky-400 dark:focus:ring-sky-700" %>
              <%= f.label :sex_female, "Female", class: "ml-2 text-gray-700 dark:text-gray-300" %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label
            class="font-medium text-gray-700 dark:text-gray-300"
            for="user_profile_weight"
          >Weight (kg)</label>
          <div class="w-1/3">
            <%= f.number_field :weight,
                           step: :any,
                           class:
                             "border border-gray-300 dark:border-gray-700 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 dark:focus:ring-sky-700 focus:border-sky-500 dark:focus:border-sky-700 focus:outline-none dark:bg-dark-surface dark:text-dark-text" %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label
            class="font-medium text-gray-700 dark:text-gray-300"
            for="user_profile_height"
          >Height (cm)</label>
          <div class="w-1/3">
            <%= f.number_field :height,
                           step: :any,
                           class:
                             "border border-gray-300 dark:border-gray-700 p-2 rounded-lg w-full text-center focus:ring-2 focus:ring-sky-300 dark:focus:ring-sky-700 focus:border-sky-500 dark:focus:border-sky-700 focus:outline-none dark:bg-dark-surface dark:text-dark-text" %>
          </div>
        </div>
      </div>
    </div>

    <div class="">
      <h2 class="text-lg font-medium text-sky-700 dark:text-sky-400 mb-4">Fitness Goals</h2>

      <div class="space-y-5">
        <div>
          <p class="font-medium text-gray-700 dark:text-gray-300 mb-2">Physical Activity</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Sedentary', 'Lightly Active', 'Moderately Active', 'Very Active', 'Extremely Active'].each do |activity| %>
              <div class="flex items-center">
                <%= f.radio_button :physical_activity,
                               activity.downcase.gsub(" ", "_"),
                               checked:
                                 (
                                   @profile.physical_activity ==
                                     activity.downcase.gsub(" ", "_")
                                 ),
                               class:
                                 "h-4 w-4 text-sky-500 dark:text-sky-600 focus:ring-sky-400 dark:focus:ring-sky-700" %>
                <%= f.label :"physical_activity_#{activity.downcase.gsub(" ", "_")}",
                        activity,
                        class: "ml-2 text-gray-700 dark:text-gray-300" %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <p class="font-medium text-gray-700 dark:text-gray-300 mb-2">Weight Goals</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Lose Weight', 'Maintain', 'Gain Weight'].each do |goal| %>
              <div class="flex items-center">
                <%= f.radio_button :weight_goals,
                               goal.downcase.gsub(" ", "_"),
                               checked: (@profile.weight_goals == goal.downcase.gsub(" ", "_")),
                               class:
                                 "h-4 w-4 text-sky-500 dark:text-sky-600 focus:ring-sky-400 dark:focus:ring-sky-700" %>
                <%= f.label :"weight_goals_#{goal.downcase.gsub(" ", "_")}",
                        goal,
                        class: "ml-2 text-gray-700 dark:text-gray-300" %>
              </div>
            <% end %>
          </div>
        </div>

        <div>
          <p class="font-medium text-gray-700 dark:text-gray-300 mb-2">Muscle Goals</p>
          <div class="grid grid-cols-1 gap-2 pl-2">
            <% ['Build Muscle', 'Maintain Muscle'].each do |muscle| %>
              <div class="flex items-center">
                <%= f.radio_button :muscle_building,
                               muscle.downcase.gsub(" ", "_"),
                               checked:
                                 (@profile.muscle_building == muscle.downcase.gsub(" ", "_")),
                               class:
                                 "h-4 w-4 text-sky-500 dark:text-sky-600 focus:ring-sky-400 dark:focus:ring-sky-700" %>
                <%= f.label :"muscle_building_#{muscle.downcase.gsub(" ", "_")}",
                        muscle,
                        class: "ml-2 text-gray-700 dark:text-gray-300" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-center">
      <button type="submit">
        <%= render "shared/aqua_style", text: "Save Profile" %>
      </button>
    </div>
  <% end %>

  <% if Current.user.is_admin? %>
    <div class="mt-10 border-t border-gray-300 dark:border-gray-700 pt-6 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-medium text-sky-700 dark:text-sky-400">Admin Settings</h2>
      </div>

      <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4">
        <div class="space-y-3">
          <% @global_settings.each do |setting| %>
            <div class="flex items-start gap-4">
              <div class="font-medium text-gray-700 dark:text-gray-300 min-w-40"><%= setting.name.humanize %></div>
              <div class="text-gray-800 dark:text-gray-200 flex-1">
                <% if setting.name == "openai_api_key" && setting.value.present? %>
                  <span
                    class="
                      bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-300 px-2 py-1
                      rounded text-xs
                    "
                  >
                    <%= heroicon "check-circle", options: { class: "inline w-3 h-3 mr-1" } %>
                    API Key Set
                  </span>
                <% else %>
                  <span class="text-gray-500 dark:text-gray-400 italic"><%= setting.value.present? ? setting.value : "Not set" %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="w-full justify-center flex">
        <a
          href="<%= global_settings_path %>"
          class="
            text-sky-600 hover:text-sky-800 dark:text-sky-400 dark:hover:text-sky-300 flex
            items-center
          "
        >
          <%= render "shared/aqua_style", text: "Manage settings" %>
        </a>
      </div>
    </div>
  <% end %>

</div>
