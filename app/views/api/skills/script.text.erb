#!/bin/bash

# Termal API CLI Script
# This script provides convenient commands for interacting with the Termal API

set -e

BASE_URL="${TERMAL_BASE_URL:-<%= base_url %>}"
API_TOKEN="${TERMAL_API_TOKEN:-}"

if [ -z "$API_TOKEN" ]; then
  echo "Error: TERMAL_API_TOKEN environment variable is required"
  echo "Set it with: export TERMAL_API_TOKEN='your_api_key_here'"
  exit 1
fi

# Helper function for making API requests
api_call() {
  local method="$1"
  local endpoint="$2"
  local data="${3:-}"
  
  if [ -n "$data" ]; then
    curl -s -X "$method" \
      -H "Authorization: Bearer $API_TOKEN" \
      -H "Content-Type: application/json" \
      -d "$data" \
      "$BASE_URL$endpoint"
  else
    curl -s -X "$method" \
      -H "Authorization: Bearer $API_TOKEN" \
      "$BASE_URL$endpoint"
  fi
}

# Display usage information
usage() {
  cat << EOF
Usage: termal-api <command> [options]

Commands:
  meals [date]              Get meals for a specific date (YYYY-MM-DD) or today
  user-meal <id>            Get a specific user meal by ID
  meal <id>                 Get a specific meal by ID
  summary [days]            Get nutrition summary for the last N days (default: 7)
  profile                   Get user profile information
  update-profile <json>     Update profile with JSON data
  search [options]          Search meals by query and/or nutrient ranges
  add <meal-id> [date] [time]  Add a meal to your log by meal ID (date: YYYY-MM-DD, time: HH:MM, defaults to today/now)

Options for search:
  --query TEXT              Search query for semantic/vector search (optional, e.g., "chicken salad")
  --calories-min N          Minimum calories
  --calories-max N          Maximum calories
  --proteins-min N          Minimum proteins (g)
  --proteins-max N          Maximum proteins (g)
  --carbs-min N             Minimum carbs (g)
  --carbs-max N             Maximum carbs (g)
  --fats-min N              Minimum fats (g)
  --fats-max N              Maximum fats (g)
  --limit N                 Maximum results (default: 20)

Environment Variables:
  TERMAL_API_TOKEN          Your API authentication token (required)
  TERMAL_BASE_URL           API base URL (default: <%= base_url %>)

Examples:
  termal-api meals 2026-03-10
  termal-api user-meal 123
  termal-api meal 456
  termal-api summary 7
  termal-api profile
  termal-api search --calories-min 300 --calories-max 500 --proteins-min 20
  termal-api search --query "chicken salad"
  termal-api search --query "high protein" --proteins-min 30 --limit 10
  termal-api add 123
  termal-api add 123 2026-04-22
  termal-api add 123 2026-04-22 14:30

Generate your API key at: $BASE_URL/profile
EOF
}

# Main command handler
case "${1:-}" in
  meals)
    date="${2:-$(date +%Y-%m-%d)}"
    api_call "GET" "/api/user_meals?date=$date"
    ;;

  user-meal)
    if [ -z "${2:-}" ]; then
      echo "Error: User meal ID required"
      echo "Usage: termal-api user-meal <id>"
      exit 1
    fi
    api_call "GET" "/api/user_meals/$2"
    ;;

  meal)
    if [ -z "${2:-}" ]; then
      echo "Error: Meal ID required"
      echo "Usage: termal-api meal <id>"
      exit 1
    fi
    api_call "GET" "/api/meals/$2"
    ;;
    
  summary)
    days="${2:-7}"
    api_call "GET" "/api/nutrition_summary?days=$days"
    ;;
    
  profile)
    api_call "GET" "/api/profile"
    ;;
    
  update-profile)
    if [ -z "${2:-}" ]; then
      echo "Error: JSON data required"
      echo "Usage: termal-api update-profile '{\"age\": 30, \"weight\": 75.5}'"
      exit 1
    fi
    api_call "PATCH" "/api/profile" "$2"
    ;;
    
  search)
    shift  # Remove 'search' command
    query_params=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --query) query_params="$query_params&query=$2"; shift 2 ;;
        --calories-min) query_params="$query_params&calories_min=$2"; shift 2 ;;
        --calories-max) query_params="$query_params&calories_max=$2"; shift 2 ;;
        --proteins-min) query_params="$query_params&proteins_min=$2"; shift 2 ;;
        --proteins-max) query_params="$query_params&proteins_max=$2"; shift 2 ;;
        --carbs-min) query_params="$query_params&carbs_min=$2"; shift 2 ;;
        --carbs-max) query_params="$query_params&carbs_max=$2"; shift 2 ;;
        --fats-min) query_params="$query_params&fats_min=$2"; shift 2 ;;
        --fats-max) query_params="$query_params&fats_max=$2"; shift 2 ;;
        --limit) query_params="$query_params&limit=$2"; shift 2 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
      esac
    done
    # Remove leading &
    query_params="${query_params#&}"
    api_call "GET" "/api/meals/search?$query_params"
    ;;

  add)
    if [ -z "${2:-}" ]; then
      echo "Error: Meal ID required"
      echo "Usage: termal-api add <meal-id> [date] [time]"
      exit 1
    fi
    meal_id="$2"
    date="${3:-$(date +%Y-%m-%d)}"
    time="${4:-}"
    if [ -n "$time" ]; then
      api_call "POST" "/api/user_meals?meal_id=$meal_id&date=$date&time=$time"
    else
      api_call "POST" "/api/user_meals?meal_id=$meal_id&date=$date"
    fi
    ;;

  --help|-h|help)
    usage
    ;;
    
  *)
    echo "Error: Unknown command '${1:-}'"
    usage
    exit 1
    ;;
esac
