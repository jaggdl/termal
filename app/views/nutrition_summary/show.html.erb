<div class="mx-auto py-6 w-full"
     data-controller="nutrition-charts"
     data-nutrition-charts-dates-value="<%= @summary[:dates].to_json %>"
     data-nutrition-charts-calories-value="<%= @summary[:calories].to_json %>"
     data-nutrition-charts-proteins-value="<%= @summary[:proteins].to_json %>"
     data-nutrition-charts-carbs-value="<%= @summary[:carbs].to_json %>"
     data-nutrition-charts-fats-value="<%= @summary[:fats].to_json %>"
     data-nutrition-charts-calories-target-value="<%= @summary[:daily_targets][:calories] %>"
     data-nutrition-charts-proteins-target-value="<%= @summary[:daily_targets][:proteins] %>"
     data-nutrition-charts-carbs-target-value="<%= @summary[:daily_targets][:carbs] %>"
     data-nutrition-charts-fats-target-value="<%= @summary[:daily_targets][:fats] %>"
     data-nutrition-charts-period-value="<%= @period %>">
  
  <h1 class="text-2xl font-bold text-center mb-6">Nutrition Summary</h1>
  
  <!-- Period selector -->
  <div class="mb-8 flex justify-center space-x-4">
    <%= link_to "Last 7 Days", nutrition_summary_path(period: 7), class: "#{@period == 7 ? 'aqua-reflection bg-gradient-to-b from-sky-300 to-sky-500' : 'bg-gray-200'} px-4 py-2 rounded-full text-sm #{@period == 7 ? 'text-white' : 'text-gray-700'}" %>
    <%= link_to "Last 14 Days", nutrition_summary_path(period: 14), class: "#{@period == 14 ? 'aqua-reflection bg-gradient-to-b from-sky-300 to-sky-500' : 'bg-gray-200'} px-4 py-2 rounded-full text-sm #{@period == 14 ? 'text-white' : 'text-gray-700'}" %>
    <%= link_to "Last 28 Days", nutrition_summary_path(period: 28), class: "#{@period == 28 ? 'aqua-reflection bg-gradient-to-b from-sky-300 to-sky-500' : 'bg-gray-200'} px-4 py-2 rounded-full text-sm #{@period == 28 ? 'text-white' : 'text-gray-700'}" %>
  </div>

  <!-- Summary cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <!-- Calories card -->
    <div data-nutrition-charts-target="card" data-type="calories" data-action="click->nutrition-charts#showNutrient" class="bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow cursor-pointer">
      <h3 class="text-lg font-semibold text-center mb-2">Calories</h3>
      <div class="text-3xl font-bold text-center mb-2"><%= @summary[:averages][:calories].round %></div>
      <div class="text-sm text-center text-gray-500 mb-2">daily average</div>
      
      <% calories_pct = @summary[:percentages][:calories] %>
      <% status_color = calories_pct > 110 ? "text-red-500" : (calories_pct < 90 ? "text-amber-500" : "text-green-500") %>
      <div class="text-center <%= status_color %>">
        <%= calories_pct %>% of target
      </div>
    </div>

    <!-- Proteins card -->
    <div data-nutrition-charts-target="card" data-type="proteins" data-action="click->nutrition-charts#showNutrient" class="bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow cursor-pointer">
      <h3 class="text-lg font-semibold text-center mb-2">Proteins</h3>
      <div class="text-3xl font-bold text-center mb-2"><%= @summary[:averages][:proteins].round(1) %>g</div>
      <div class="text-sm text-center text-gray-500 mb-2">daily average</div>
      
      <% proteins_pct = @summary[:percentages][:proteins] %>
      <% status_color = proteins_pct > 110 ? "text-green-500" : (proteins_pct < 90 ? "text-amber-500" : "text-green-500") %>
      <div class="text-center <%= status_color %>">
        <%= proteins_pct %>% of target
      </div>
    </div>

    <!-- Carbs card -->
    <div data-nutrition-charts-target="card" data-type="carbs" data-action="click->nutrition-charts#showNutrient" class="bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow cursor-pointer">
      <h3 class="text-lg font-semibold text-center mb-2">Carbs</h3>
      <div class="text-3xl font-bold text-center mb-2"><%= @summary[:averages][:carbs].round(1) %>g</div>
      <div class="text-sm text-center text-gray-500 mb-2">daily average</div>
      
      <% carbs_pct = @summary[:percentages][:carbs] %>
      <% status_color = carbs_pct > 110 ? "text-red-500" : (carbs_pct < 90 ? "text-amber-500" : "text-green-500") %>
      <div class="text-center <%= status_color %>">
        <%= carbs_pct %>% of target
      </div>
    </div>

    <!-- Fats card -->
    <div data-nutrition-charts-target="card" data-type="fats" data-action="click->nutrition-charts#showNutrient" class="bg-white rounded-lg shadow-md p-4 hover:shadow-lg transition-shadow cursor-pointer">
      <h3 class="text-lg font-semibold text-center mb-2">Fats</h3>
      <div class="text-3xl font-bold text-center mb-2"><%= @summary[:averages][:fats].round(1) %>g</div>
      <div class="text-sm text-center text-gray-500 mb-2">daily average</div>
      
      <% fats_pct = @summary[:percentages][:fats] %>
      <% status_color = fats_pct > 110 ? "text-red-500" : (fats_pct < 90 ? "text-amber-500" : "text-green-500") %>
      <div class="text-center <%= status_color %>">
        <%= fats_pct %>% of target
      </div>
    </div>
  </div>

  <!-- Single Dynamic Chart -->
  <div class="bg-white rounded-lg shadow-md p-4">
    <h3 class="text-lg font-semibold mb-4">Nutrient Over Time</h3>
    <p class="text-sm text-gray-500 mb-4">Click on a card above to view different nutrients</p>
    <div class="max-h-[560px]">
      <canvas data-nutrition-charts-target="chart" height="400"></canvas>
    </div>
  </div>
</div>
