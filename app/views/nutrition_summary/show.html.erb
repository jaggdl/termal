<div class="mb-6" data-controller="meal-selection">
  <%= form_with url: nutrition_summary_path, method: :get, local: true,
                class: "flex gap-2 items-end" do |f| %>
    <%= f.hidden_field :period, value: @period %>
    <%= f.hidden_field :nutrient, value: @selected_nutrient %>

    <div class="flex-grow">
      <%= f.label :query, "Filter by meal type (e.g., breakfast, healthy, snacks)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <div class="relative">
        <%= f.text_field :query,
                        value: @query,
                        placeholder: "Enter a search term...",
                        class: "w-full bg-white dark:bg-dark-surface border border-gray-300 dark:border-gray-700 rounded-md py-2 pl-4 pr-10 focus:outline-none focus:ring-2 focus:ring-sky-500 dark:focus:ring-dark-primary text-black dark:text-dark-text" %>
        <% if @query.present? %>
          <%= link_to nutrition_summary_path(period: @period, nutrient: @selected_nutrient),
                      class: "absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300" do %>
            <%= heroicon "x-mark", options: { class: "w-5 h-5" } %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= f.submit "Search", class: "bg-sky-500 hover:bg-sky-600 text-white font-medium py-2 px-4 rounded-md transition-colors duration-200" %>
  <% end %>
</div>

<%= render partial: 'shared/nutrient_summary_charts',
            locals: {
              chart_data: @summary[:chart_data],
              period: @period,
              selected_nutrient: @selected_nutrient,
              averages: @summary[:averages],
              daily_targets: @summary[:daily_targets],
              show_period_selector: true,
              query: @query,
              selected_meal_ids: @selected_meal_ids
            } %>

<% if @query.present? && @matching_meals&.any? %>
  <div class="mt-4 p-4 bg-white dark:bg-dark-surface rounded-lg border border-gray-200 dark:border-gray-700">
    <div class="flex justify-between items-center mb-3">
      <h4 class="font-medium text-gray-900 dark:text-dark-text">Select meals to display:</h4>
      <div class="flex gap-2">
        <button type="button" data-action="meal-selection#selectAll"
                class="text-sm text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300">
          Select All
        </button>
        <span class="text-gray-300">|</span>
        <button type="button" data-action="meal-selection#deselectAll"
                class="text-sm text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300">
          Deselect All
        </button>
      </div>
    </div>

    <%= form_with url: nutrition_summary_path, method: :get, local: true,
                  class: "space-y-2 overflow-y-auto",
                  data: { "meal-selection-target": "form" } do |f| %>
      <%= f.hidden_field :period, value: @period %>
      <%= f.hidden_field :nutrient, value: @selected_nutrient %>
      <%= f.hidden_field :query, value: @query %>

      <% @matching_meals.each do |meal| %>
        <div class="flex items-center gap-3 p-2 hover:bg-gray-50 dark:hover:bg-gray-800 rounded">
          <%= check_box_tag "selected_meal_ids[]",
                          meal.id,
                          @selected_meal_ids.include?(meal.id.to_s) || @selected_meal_ids.empty?,
                          id: "meal_#{meal.id}",
                          class: "w-4 h-4 text-sky-600 border-gray-300 rounded focus:ring-sky-500",
                          data: { action: "change->meal-selection#submit" } %>
          <%= meal_image_tag(meal, size: :small) %>
          <%= label_tag "meal_#{meal.id}", class: "flex-grow cursor-pointer text-sm text-gray-700 dark:text-gray-300" do %>
            <span class="font-medium"><%= meal.meal_name %></span>
            <span class="text-gray-500 dark:text-gray-500">(consumed <%= pluralize(meal.consumption_count, 'time') %>)</span>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <% if @selected_meal_ids.present? %>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        Showing data for <%= pluralize(@selected_meal_ids.length, 'selected meal') %>
      </p>
    <% else %>
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-500 italic">
        All matching meals are currently shown. Select specific meals above to filter.
      </p>
    <% end %>
  </div>
<% elsif @query.present? %>
  <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
    No meals found matching "<strong><%= @query %></strong>" in the selected time period.
  </p>
<% end %>

