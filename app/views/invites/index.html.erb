<div class="max-w-4xl mx-auto py-6">
  <!-- Invite Section -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Invite Link</h2>
    </div>
    
    <div class="px-6 py-4">
      <% if @invite %>
        <div class="mb-6">
          <div class="flex items-center" data-controller="clipboard">
            <input type="text" readonly value="<%= join_url(@invite.token) %>" id="invite-link" 
                   class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 bg-gray-50"
                   data-clipboard-target="source">
            <button data-action="click->clipboard#copy" class="ml-2 inline-flex items-center p-2 border border-transparent rounded-md text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" title="Copy to clipboard">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
          <p class="mt-2 text-sm text-gray-500">
            This link will remain valid until manually invalidated
          </p>
        </div>
        
        <div class="flex justify-center sm:flex-row sm:space-x-4 space-y-3 sm:space-y-0">
          <%= button_to regenerate_invite_path, method: :post, class: "inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Generate New Link
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No active invite link</h3>
          <p class="mt-1 text-sm text-gray-500">Generate a new invite link to allow others to sign up.</p>
          <div class="mt-6">
            <%= button_to regenerate_invite_path, method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Generate Invite Link
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Family Members Section -->
  <div class="bg-white rounded-lg shadow mb-8">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Family Members</h2>
    </div>
    
    <div class="divide-y divide-gray-200">
      <% if @users.empty? %>
        <div class="text-center py-6 px-4">
          <p class="text-gray-500">No users found</p>
        </div>
      <% else %>
        <% @users.each do |user| %>
          <div class="px-6 py-4 flex items-center">
            <div class="flex-shrink-0">
              <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                <span class="text-blue-600 font-medium"><%= user.email_address[0].upcase %></span>
              </div>
            </div>
            <div class="ml-4 flex-1">
              <div class="text-sm font-medium text-gray-900"><%= user.email_address %></div>
              <div class="text-sm text-gray-500">
                <% if user.first_user? %>
                  Admin
                <% else %>
                  Member
                <% end %>
                <%= "• Joined #{time_ago_in_words(user.created_at)} ago" %>
              </div>
            </div>
            <div class="ml-2">
              <% if user.first_user? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  Admin
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  
</div>

