<div class="mx-auto py-6 w-full">
  <!-- Invite Section -->
  <div class="mb-8 w-full">
    <div class="py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-medium text-gray-900 dark:text-dark-text">Invite Link</h2>
    </div>

    <div class="py-4">
      <div class="mb-6">
        <div class="flex items-center" data-controller="clipboard">
          <input
            type="text"
            readonly
            value="<%= join_url(@invite.token) %>"
            id="invite-link"
            class="
              shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm
              border-gray-300 dark:border-gray-700 rounded-md py-2 px-3 bg-gray-50 dark:bg-dark-surface dark:text-dark-text
            "
            data-clipboard-target="source"
          >
          <button
            data-action="click->clipboard#copy"
            class="
              ml-2 inline-flex items-center p-2 border border-transparent rounded-md
              text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2
              focus:ring-offset-2 focus:ring-blue-500 dark:focus:ring-dark-primary
            "
            title="Copy to clipboard"
          >
            <%= heroicon "clipboard-document", options: { class: "h-5 w-5" } %>
          </button>
        </div>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
          This link will remain valid until regenerated
        </p>
      </div>

      <div
        class="
          flex justify-center sm:flex-row sm:space-x-4 space-y-3 sm:space-y-0
        "
      >
        <%= button_to regenerate_invite_path, method: :post do %>
          <%= render "shared/aqua_style",
          text: "Regenerate Link",
          variant: "secondary",
          icon: "arrow-path" %>
        <% end %>
      </div>
    </div>
  </div>
  <!-- Family Members Section -->
  <div class="w-full">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-medium text-gray-900 dark:text-dark-text">Family Members</h2>
    </div>

    <div class="divide-y divide-gray-200 dark:divide-gray-700 w-full">
      <% if @users.empty? %>
        <div class="text-center py-6 px-4">
          <p class="text-gray-500 dark:text-gray-400">No users found</p>
        </div>
      <% else %>
        <% @users.each do |user| %>
          <div class="py-4 flex items-center gap-1 w-full">
            <div class="">
              <div
                class="
                  w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center
                "
              >
                <span class="text-blue-600 dark:text-blue-400 font-medium"><%= user.email_address[0].upcase %></span>
              </div>
            </div>
            <div class="ml-4 w-full text-sm line-clamp-1">
              <div class="text-gray-900 dark:text-dark-text line-clamp-1"><%= user.email_address %></div>
              <div class="text-gray-500 dark:text-gray-400">
                <% if user.is_admin? %>
                  Admin
                <% else %>
                  Member
                <% end %>
                <%= "• Joined #{time_ago_in_words(user.created_at)} ago" %>
              </div>
            </div>
            <div class="ml-2 flex items-center">
              <% if user.is_admin? %>
                <span
                  class="
                    inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300
                  "
                >
                  Admin
                </span>
              <% else %>
                <%= button_to delete_family_user_path(user), method: :delete, 
                    class: "text-red-600 hover:text-red-800 dark:text-red-500 dark:hover:text-red-400 p-2 focus:outline-none",
                    form: { onsubmit: "return confirm('Are you sure you want to delete this user? This cannot be undone.')" },
                    title: "Delete user" do %>
                  <%= heroicon "trash", options: { class: "h-5 w-5" } %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
