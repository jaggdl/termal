<% disabled = local_assigns.fetch(:disabled, false) %>
<% if disabled %>
  <span class="flex items-center justify-center px-4 text-sm py-2 rounded-full bg-gray-200 text-gray-400"><%= text %></span>
<% else %>
  <%= link_to path do %>
    <div class="relative">
      <span class="aqua-reflection flex items-center text-sm justify-center px-4 py-2 rounded-full bg-gradient-to-b from-sky-300 to-sky-500 text-white shadow-md hover:from-sky-400 hover:to-sky-600"><%= text %></span>
    </div>
  <% end %>
<% end %>
