<div class="relative mb-4" data-controller="search">
  <form action="/meals/search" method="get" data-turbo-frame="search_results" data-search-target="form">
    <div class="grid grid-cols-1 w-full">
      <input 
        type="text" 
        name="q" 
        placeholder="Search meals..." 
        data-search-target="input" 
        data-action="input->search#search input->search#toggleClearButton"
        class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pl-10 pr-3 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-sky-400 sm:pl-9 sm:text-sm/6" 
      >
      <%= heroicon "magnifying-glass", options: { class: "pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400 sm:size-4" } %>
    </div>
    <button 
      class="absolute right-4 top-1 hidden"
      type="button" 
      data-search-target="clearButton" 
      data-action="click->search#clear">
      Clear
    </button>
  </form>
  <turbo-frame id="search_results" data-search-target="results">
    <!-- Search results will appear here -->
  </turbo-frame>
</div>
