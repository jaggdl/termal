<div class="relative mb-4 group" data-controller="search" data-state="idle">
  <form
    action="/meals/search"
    method="get"
    data-turbo-frame="search_results"
    data-search-target="form"
    data-action="
      turbo:submit-start->search#startSubmit
      turbo:submit-end->search#endSubmit
    "
  >
    <div class="grid grid-cols-1 w-full">
      <input
        type="text"
        name="q"
        autocomplete="off"
        placeholder="Search meals..."
        data-search-target="input"
        data-action="input->search#search input->search#updateHasValue focus->search#focus keydown->search#keydown"
        class="
          col-start-1 row-start-1 block w-full rounded-md bg-white dark:bg-dark-surface
          py-1.5 pl-10 pr-3 text-base text-gray-900 dark:text-dark-text outline outline-1
          -outline-offset-1 outline-gray-300 dark:outline-gray-700
          placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:outline
          focus:outline-2 focus:-outline-offset-2 focus:outline-sky-400
          dark:focus:outline-dark-primary sm:pl-9 sm:text-sm/6 transition-colors
          duration-200
        "
      >
      <% if params[:date].present? %>
        <input type="hidden" name="date" value="<%= params[:date] %>">
      <% end %>

      <div
        class="
          pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center
          text-gray-400 dark:text-gray-500 sm:size-4
          group-data-[state=loading]:hidden
        "
      >
        <%= heroicon "magnifying-glass", options: { class: "" } %>
      </div>
      <div
        class="
          pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center
          text-primary-500 hidden group-data-[state=loading]:block
        "
      >
        <%= heroicon "arrow-path",
        options: {
          class: "size-5 animate-spin text-gray-600 dark:text-gray-400",
        } %>
      </div>
    </div>
    <button
      class="
        absolute right-4 top-1.5 items-center gap-2
        flex group-data-[state=idle]:hidden
      "
      type="button"
      data-action="click->search#clear"
    >
      <%= heroicon "x-mark", options: { class: "size-6 text-gray-600 dark:text-gray-400" } %>
    </button>
  </form>

  <div
    class="
      absolute top-10 shadow-lg bg-white/80 dark:bg-dark-surface/80 z-10 md:left-auto
      -left-5 backdrop-blur-lg w-screen md:w-full right-0 rounded-md border
      border-sky-300 dark:border-sky-700 transition-colors duration-200
      max-h-[calc(100vh_-_6.5rem_-_var(--nav-b-padding))] md:max-h-max
      overflow-y-scroll md:overflow-y-auto
      hidden
      group-data-[state=suggestions]:block
      group-data-[state=loading]:block
      group-data-[state=results]:block
    "
  >
    <turbo-frame
      id="search_results"
      class="hidden group-data-[state=loading]:block group-data-[state=results]:block"
    >
      <!-- Vector search results will appear here -->
    </turbo-frame>
    <% if local_assigns[:suggestions] %>
      <div
        data-search-target="suggestions"
        class="hidden group-data-[state=suggestions]:block"
      >
        <%= render partial: "shared/meal_list", locals: { meals: suggestions, date: params[:date] } %>
      </div>
    <% end %>
  </div>
</div>
