<div class="relative mb-4" data-controller="search">
  <form action="/meals/search" method="get" data-turbo-frame="search_results" data-search-target="form" data-action="turbo:submit-start->search#startSubmit turbo:submit-end->search#endSubmit">
    <div class="grid grid-cols-1 w-full">
      <input 
        type="text" 
        name="q" 
        placeholder="Search meals..." 
        data-search-target="input" 
        data-action="input->search#search input->search#toggleClearButton"
        class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pl-10 pr-3 text-base text-gray-900 outline outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-sky-400 sm:pl-9 sm:text-sm/6" 
      >
      <% if params[:date].present? %>
        <input type="hidden" name="date" value="<%= params[:date] %>">
      <% end %>

      <div data-search-target="searchIcon" class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400 sm:size-4">
        <%= heroicon "magnifying-glass", options: { class: "" } %>
      </div>
      <div data-search-target="loader" class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-primary-500 hidden">
        <%= heroicon "arrow-path", options: { class: "size-5 animate-spin text-gray-600" } %>
      </div>
    </div>
    <button 
      class="absolute right-4 top-1.5 hidden flex items-center gap-2"
      type="button" 
      data-search-target="clearButton" 
      data-action="click->search#clear">
      Clear
      <%= heroicon "x-mark", options: { class: "size-5 text-gray-600" } %>
    </button>
  </form>
  
  <form class="hidden" action="/meals/normal_search" method="get" data-turbo-frame="normal_search_results" data-search-target="normalSearchForm">
    <input 
      type="text" 
      name="q" 
      data-search-target="normalSearchInput"
      hidden
    >
    <% if params[:date].present? %>
      <input type="hidden" name="date" value="<%= params[:date] %>">
    <% end %>
  </form>

  <div class="fixed md:absolute md:top-10 top-16  shadow-lg bg-white/80 z-10 backdrop-blur-lg w-screen md:w-full p-2 hidden left-0 right-0 rounded-md border border-sky-200" data-search-target="resultsContainer" >
    <turbo-frame id="normal_search_results" data-search-target="normalSearchResults">
      <!-- Normal search results will appear here -->
    </turbo-frame>
    <turbo-frame id="search_results" data-search-target="results"> 
      <!-- Vector search results will appear here -->
    </turbo-frame>
  </div>
</div>
