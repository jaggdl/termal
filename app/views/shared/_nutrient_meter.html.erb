<div class="mb-4 w-24 md:w-32">
  <% total_value = meals.sum { |meal| meal.send(unit) || 0 } %>
  <% nutrient_percentage = (total_value.to_f / base_number) * 100 %>
  <% meter_color = nutrient_percentage > 100 ? "bg-gradient-to-r from-red-300 to-red-500 shadow-red-400/40" : "bg-gradient-to-r from-sky-300 to-sky-400 shadow-sky-400/40" %>

  <div class="text-center mb-1">
    <span class="text-sm">
      <span class="hidden md:block"><%= total_value %> / <%= base_number %></span> <%= unit.humanize %>
    </span>
  </div>

  <!-- Outer container for the bar -->
  <div class="w-full bg-gray-200 rounded-full h-3 shadow-inner">
    <!-- Inner progress bar with Aqua style -->
    <div class="h-3 rounded-full <%= meter_color %> relative shadow-md aqua-reflection" style="width: <%= [nutrient_percentage, 100].min %>%"></div>
  </div>
</div>
