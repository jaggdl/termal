<div id="flash" class="p-4 m-auto max-w-4xl flex flex-col items-end justify-end w-full space-y-2">
  <% flash.each do |key, message| %>
    <% border_color = case key.to_s
       when 'notice' then 'border-green-500'
       when 'alert' then 'border-red-500'
       when 'warning' then 'border-amber-500'
       else 'border-blue-500'
       end %>
    
    <% text_color = case key.to_s
       when 'notice' then 'text-green-700'
       when 'alert' then 'text-red-700'
       when 'warning' then 'text-amber-700'
       else 'text-blue-700'
       end %>
    
    <div class="flex justify-between items-center mb-2 p-4 rounded-lg backdrop-blur-sm w-auto max-w-md
                bg-white/80 shadow-lg border-2 <%= border_color %> <%= text_color %> pointer-events-auto"
         data-controller="flash" data-flash-key="<%= key %>">
      <span><%= message %></span>
      <button type="button" class="ml-4 p-2 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-gray-400" 
              aria-label="Close notification" 
              data-action="click->flash#close">
        <%= heroicon "x-mark", options: { class: "h-5 w-5" } %>
      </button>
    </div>
  <% end %>
</div>
