<% arrow = direction == 'left' ? '‹' : '›' %>
<div class="relative">
  <% if disabled %>
    <span class="flex items-center justify-center w-6 h-6 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-400 dark:text-gray-500 text-xl transition-colors duration-200"><%= arrow %></span>
  <% else %>
    <span class="aqua-reflection flex items-center justify-center w-6 h-6 rounded-full bg-gradient-to-b from-sky-300 to-sky-500 dark:from-sky-500 dark:to-sky-700 text-white shadow-md group-hover:from-sky-400 group-hover:to-sky-600 dark:group-hover:from-sky-600 dark:group-hover:to-sky-800 text-xl transition-all duration-200"><%= arrow %></span>
  <% end %>
</div>
