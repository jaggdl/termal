<div id="nutrient-meters-<%= date.to_s %>" class="flex space-x-4">
  <%= render partial: 'shared/nutrient_meter', 
            locals: { user_meals: user_meals, unit: 'calories', base_number: user_profile.daily_targets[:calories] } %>
  <%= render partial: 'shared/nutrient_meter', 
            locals: { user_meals: user_meals, unit: 'proteins', base_number: user_profile.daily_targets[:protein] } %>
</div>
