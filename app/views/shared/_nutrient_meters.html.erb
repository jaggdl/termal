<div id="nutrient-meters-<%= date.to_s %>" class="grid gap-x-4 grid-cols-2 md:grid-cols-4">
  <% main_nutrients.each do |nutrient| %>
    <div class="flex w-32">
      <%= render partial: 'shared/nutrient_meter', 
                locals: { user_meals: user_meals, unit: nutrient, daily_targets: user_profile.daily_targets, show_unit: true, show_nutrient: true } %>
    </div>
  <% end %>
</div>
