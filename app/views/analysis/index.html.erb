<div class="mx-auto pt-8 w-full space-y-8">
  <div class="md:flex md:items-center md:justify-between">
    <%= form_with url: analysis_index_path, method: :post, class: "flex flex-col items-center w-full" do %>
      <div class="flex flex-col items-center space-y-3">
        <div class="flex items-center">
          <%= check_box_tag :include_meal_data, "1", false, class: "h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" %>
          <label for="include_meal_data" class="ml-2 block text-sm text-gray-700">Include meal details</label>
        </div>
        <div class="flex items-center">
          <label for="period" class="block text-sm text-gray-700 mr-2">Period:</label>
          <%= select_tag :period, options_for_select([
            ["Today", "today"],
            ["Yesterday", "yesterday"],
            ["Last Week", "last_week"]
          ]), class: "block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm rounded-md" %>
        </div>
        <button type="submit" class="mt-3">
          <%= render 'shared/aqua_style', text: 'Generate new analysis', icon: 'sparkles' %>
        </button>
      </div>
    <% end %>
  </div>

  <% if @analyses.present? %>
    <div class="overflow-hidden">
      <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">
          Your Analysis History
        </h3>
      </div>
      
      <ul class="divide-y divide-gray-200">
        <% @analyses.each do |analysis| %>
          <li>
            <a href="<%= analysis_path(analysis) %>" class="block hover:bg-gray-50">
              <div class="px-4 py-4 sm:px-6">
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <%= heroicon "academic-cap", options: { class: "mr-2 h-5 w-5 text-blue-500" } %>
                    <p class="text-md font-medium text-gray-900 truncate">
                      Analysis for <%= analysis.formatted_date_range %> 
                      <% if analysis.period.present? %>
                        (<%= analysis.period.humanize %>)
                      <% end %>
                    </p>
                  </div>
                  <div class="ml-2 flex-shrink-0 flex space-x-2">
                    <% if analysis.include_meal_data? %>
                      <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                        <%= heroicon "clipboard-document-list", options: { class: "h-3 w-3 mr-1" } %> Detailed
                      </p>
                    <% end %>
                    <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                      <%= time_ago_in_words(analysis.executed_at) %> ago
                    </p>
                  </div>
                </div>
                <div class="mt-2 sm:flex sm:justify-between">
                  <div class="sm:flex">
                    <p class="flex items-center text-sm text-gray-500 truncate">
                      <%= heroicon "calendar", options: { class: "flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" } %>
                      <%= analysis.executed_at.strftime("%B %d, %Y at %I:%M %p") %>
                    </p>
                  </div>
                </div>
              </div>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="px-4 py-5 sm:p-6 text-center">
      <h3 class="mt-2 text-sm font-medium text-gray-900">No Analyses Available</h3>
      <p class="mt-1 text-sm text-gray-500">
        <% if GlobalSetting.get("openai_api_key").blank? %>
          Nutritional analysis requires an OpenAI API key to be configured in global settings.
        <% else %>
          Click the button above to generate your first nutritional analysis.
        <% end %>
      </p>
      <div class="mt-6">
        <% if GlobalSetting.get("openai_api_key").blank? %>
          <a href="<%= global_settings_path %>" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <%= heroicon "cog", options: { class: "mr-2 -ml-1 h-5 w-5" } %>
            Configure Settings
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
