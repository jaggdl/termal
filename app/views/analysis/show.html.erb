<div class="w-full">
  <div class="space-y-4">
    <%= link_to request.referer || root_path, class: "flex gap-2 group p-2 relative" do %>
      <%= render partial: "shared/arrow_button", locals: { direction: "left", disabled: false } %>
      <span>Back</span>
    <% end %>

    <div class="">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <h3 class="text-lg leading-6 font-medium text-gray-900">
            Professional Analysis
          </h3>
        </div>
        <span class="text-sm text-gray-500 flex flex-col">
          <%= @analysis.formatted_date_range %> • Generated <%= time_ago_in_words(@analysis.executed_at) %> ago
          <% if @analysis.include_meal_data? %>
            • <span class="text-blue-600"><%= heroicon "clipboard-document-list", options: { class: "inline h-4 w-4 mr-1" } %>Detailed meal data included</span>
          <% end %>
        </span>
      </div>
    </div>
    
    <div class="prose" id="nutrition_analysis_content">
      <%= markdown(@analysis.text) %>
    </div>
  </div>
</div>
