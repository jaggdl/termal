<div class="mx-auto pt-8 w-full space-y-8">
  <div class="md:flex md:items-center md:justify-between">
    <%= form_with url: analyses_path, method: :post, class: "flex flex-col items-center w-full" do %>
      <div class="flex flex-col items-center space-y-3">
        <div class="flex items-center">
          <label for="period" class="block text-sm text-gray-700 dark:text-gray-300 mr-2">Period:</label>
          <%= select_tag :period, options_for_select([
            ["Today", "today"],
            ["Yesterday", "yesterday"],
            ["Last Week", "last_week"],
          ]), class: "block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-700 dark:bg-dark-surface dark:text-dark-text focus:outline-none focus:ring-green-500 focus:border-green-500 dark:focus:ring-dark-primary dark:focus:border-dark-primary sm:text-sm rounded-md" %>
        </div>
        <button type="submit" class="mt-3">
          <%= render 'shared/aqua_style', text: 'Generate new analysis', icon: 'sparkles' %>
        </button>
      </div>
    <% end %>
  </div>

  <% if @analyses.present? %>
    <div class="">
      <div class="py-5 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-dark-text">
          Your Analysis History
        </h3>
      </div>
      
      <%= turbo_stream_from [Current.user, "analyses"] %>
      
      <ul class="divide-y divide-gray-200 dark:divide-gray-700 -mx-5 md:mx-0" id="analyses_list">
        <% @analyses.each do |analysis| %>
          <%= render analysis %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="px-4 py-5 sm:p-6 text-center">
      <h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-dark-text">No Analyses Available</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <% if GlobalSetting.get("openai_api_key").blank? %>
          Nutritional analysis requires an OpenAI API key to be configured in global settings.
        <% else %>
          Click the button above to generate your first nutritional analysis.
        <% end %>
      </p>
      <div class="mt-6">
        <% if GlobalSetting.get("openai_api_key").blank? %>
          <a href="<%= global_settings_path %>" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-700 dark:hover:bg-indigo-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:focus:ring-dark-primary">
            <%= heroicon "cog", options: { class: "mr-2 -ml-1 h-5 w-5" } %>
            Configure Settings
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
