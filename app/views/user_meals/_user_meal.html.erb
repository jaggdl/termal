<li class="flex gap-x-4 items-center">
  <%= link_to user_meal_path(user_meal), class: "flex gap-x-4 items-center vintage-link w-full backdrop-blur-xs" do %>
    <div>
      <%= image_tag user_meal.meal.image.variant(resize_to_limit: [256, 256]), 
        class: "md:max-w-32 md:max-h-32 md:min-w-32 md:min-h-32 min-w-24 min-h-24 max-w-24 max-h-24 object-cover" %>
    </div>  
    
    <%= render partial: 'user_meals/meal_info', locals: { user_meal: user_meal } %>
  <% end %>
</li>
