<div id="user-meal-<%= user_meal.id %>" class="flex md:flex-row flex-col justify-between w-full md:items-center pr-4">
  <div class="flex flex-col">
    <div class="flex items-center">
      <span class="md:text-lg"><%= user_meal.meal&.meal_name || "" %></span>
    </div>
    <span class="text-sm text-gray-500"><%= user_meal.consumed_at_in_timezone.strftime("%I:%M %p") %></span>
    <% if user_meal.error.present? %>
      <span class="text-sm text-red-600 mt-1">Error: <%= user_meal.error_message %></span>
    <% end %>
  </div>

  <% if user_meal.error.present? %>
    <div class="flex items-center">
      <div class="flex items-center text-red-600 mr-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Processing failed</span>
      </div>
      
      <%= button_to retry_processing_user_meal_path(user_meal), method: :post, 
          class: "bg-blue-500 hover:bg-blue-600 text-white py-1 px-3 rounded text-sm flex items-center",
          onclick: "event.stopPropagation()",
          form: { "data-turbo" => true } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
        </svg>
        Retry
      <% end %>
    </div>
  <% elsif user_meal.meal&.meal_name.present? %>
    <%= render partial: 'meals/nutrients_table', locals: { meal: user_meal.meal } %>
  <% else %>
    <div class="flex items-center space-x-2 text-gray-500">
      <div class="w-4 h-4 border-2 border-gray-300 border-t-gray-500 rounded-full animate-spin"></div>
      <span>Processing...</span>
    </div>
  <% end %>
</div>
