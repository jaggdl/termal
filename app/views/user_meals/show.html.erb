<div class="space-y-6">
  <%= render partial: "shared/back_button" %>

  <%= render partial: "shared/meal_details",
  locals: {
    meal: @user_meal.meal,
    user_profile: @user_profile,
  } %>

  <div class="mt-6 flex justify-end gap-x-4">
    <%= link_to edit_meal_path(@user_meal.meal) do %>
      <%= render "shared/aqua_style",
      text: "Edit meal",
      variant: "secondary",
      icon: "pencil" %>
    <% end %>
  </div>

  <%= form_with model: @user_meal, url: user_meal_path(@user_meal), method: :patch, class: "space-y-4", data: { controller: "datetime-sync", "datetime-sync-timezone": Current.user_profile.timezone } do |f| %>
    <div class="flex flex-col items-end gap-4">
      <div class="flex items-center gap-4 w-full">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Consumed:</span>
        <%= f.datetime_local_field :consumed_at_local,
                               value:
                                 @user_meal.consumed_at_in_timezone.strftime(
                                   "%Y-%m-%dT%H:%M",
                                 ),
                               class:
                                 "border border-gray-300 dark:border-gray-700 p-1 rounded w-full dark:bg-dark-surface dark:text-dark-text",
                               placeholder: "Select date and time",
                               data: {
                                 "datetime-sync-target": "localInput",
                                 action: "input->datetime-sync#localChanged",
                               } %>
        <%= f.hidden_field :consumed_at, data: { "datetime-sync-target": "utcInput" } %>
      </div>
      <div class="flex gap-2">
        <%= link_to user_meal_path(@user_meal),
        data: {
          turbo_method: "delete",
          turbo_confirm: "Are you sure?",
        }  do %>
          <%= render "shared/aqua_style", text: "Remove", variant: "danger" %>
        <% end %>
        <%= f.submit "Update date",
                 class:
                   "aqua-reflection flex items-center text-sm justify-center px-4 py-2 rounded-full bg-gradient-to-b from-sky-300 to-sky-500 text-white shadow-md hover:from-sky-400 hover:to-sky-600 dark:from-sky-600 dark:to-sky-800 dark:hover:from-sky-500 dark:hover:to-sky-700 cursor-pointer" %>
      </div>

      <% if @user_meal.has_location? %>
        <div class="w-full">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-semibold text-gray-700 dark:text-gray-300">Location:</span>
          </div>
          <div
            class="
              w-full h-64 rounded-lg overflow-hidden border border-gray-300
              dark:border-gray-700
            "
          >
            <iframe
              width="100%"
              height="100%"
              frameborder="0"
              scrolling="no"
              marginheight="0"
              marginwidth="0"
              src="https://www.openstreetmap.org/export/embed.html?bbox=<%= @user_meal.longitude - 0.01 %>,<%= @user_meal.latitude - 0.01 %>,<%= @user_meal.longitude + 0.01 %>,<%= @user_meal.latitude + 0.01 %>&layer=mapnik&marker=<%= @user_meal.latitude %>,<%= @user_meal.longitude %>"
              style="border: 0"
            ></iframe>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

