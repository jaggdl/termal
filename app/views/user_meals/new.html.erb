<div class="mb-6">
  <h1 class="text-xl font-semibold text-gray-800 mb-4">Add a New Meal</h1>
  <p class="text-gray-600 mb-6 text-sm">You can either upload an image of your meal or describe it in the text field below.</p>
</div>

<%= form_with(model: @user_meal, local: true, class: "space-y-6", data: { controller: "image-preview" }) do |form| %>
  <% if @date.present? %>
    <%= hidden_field_tag :date, @date %>
  <% end %>
  <div class="space-y-2">
    <%= form.label :prompt, "Meal Description", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :prompt, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "Describe your meal (e.g., 'Chicken caesar salad with croutons and parmesan')" %>
    <p class="text-xs text-gray-500 mt-1">
      <% if form.object.new_record? %>
        Required if no image is uploaded. Will help improve analysis if provided with an image.
      <% else %>
        Helps improve nutritional analysis accuracy.
      <% end %>
    </p>
  </div>

  <div>
    <canvas height="1000" width="1000" class="w-48 h-48 object-cover rounded-lg shadow-sm bg-gray-100" data-image-preview-target="previewCanvas" width="1000" height="1000"></canvas>
  </div>

  <div class="space-y-2">
    <%= form.label :file, "Upload Meal Image (Optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.file_field :file, 
        accept: "image/*", 
        class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100", 
        data: { action: "change->image-preview#previewImage", "image-preview-target": "input" } %>
    <p class="text-xs text-gray-500 mt-1">Image will be analyzed to determine nutritional content</p>
  </div>

  <div class="w-full flex justify-center">
    <div class="relative">
      <%= form.submit "Create Meal", class: "aqua-reflection flex items-center text-sm justify-center px-4 py-2 rounded-full bg-gradient-to-b from-sky-300 to-sky-500 text-white shadow-md hover:from-sky-400 hover:to-sky-600 cursor-pointer" %>
    </div>
  </div>
<% end %>
