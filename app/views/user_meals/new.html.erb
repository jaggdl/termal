<div class="mb-6">
  <h1 class="text-xl font-semibold text-gray-800 dark:text-dark-text mb-4">Add a New Meal</h1>
</div>

<%= form_with(model: @user_meal, local: true, class: "space-y-6", data: { controller: "image-preview meal-location" }) do |form| %>
  <% if @date.present? %>
    <%= hidden_field_tag :date, @date %>
  <% end %>
  <%= form.hidden_field :latitude, data: { meal_location_target: "latitude" } %>
  <%= form.hidden_field :longitude, data: { meal_location_target: "longitude" } %>
  <div class="space-y-2">
    <%= form.label :prompt, "Meal Description", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :prompt, class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-700 dark:bg-dark-surface dark:text-dark-text shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:focus:ring-dark-primary dark:focus:border-dark-primary sm:text-sm", placeholder: "Describe your meal (e.g., 'Chicken caesar salad with croutons and parmesan')" %>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4" data-image-preview-target="previewContainer">
    <canvas height="1000" width="1000" class="w-48 h-48 object-cover rounded-lg shadow-sm bg-gray-100 dark:bg-gray-800 hidden" data-image-preview-target="previewCanvas" width="1000" height="1000"></canvas>
  </div>

  <div class="space-y-2">
    <%= form.label :files, "Upload Meal Images (Optional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.file_field :files, 
        accept: "image/*", 
        multiple: true,
        class: "block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 dark:file:bg-blue-900 dark:file:text-blue-300 hover:file:bg-blue-100 dark:hover:file:bg-blue-800", 
        data: { action: "change->image-preview#previewImages", "image-preview-target": "input" } %>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Images will be analyzed to determine nutritional content. You can select multiple images.</p>
  </div>

  <div class="w-full flex justify-center">
    <div class="relative">
      <%= form.submit "Create Meal", class: "aqua-reflection flex items-center text-sm justify-center px-4 py-2 rounded-full bg-gradient-to-b from-sky-300 to-sky-500 text-white shadow-md hover:from-sky-400 hover:to-sky-600 dark:from-sky-600 dark:to-sky-800 dark:hover:from-sky-500 dark:hover:to-sky-700 cursor-pointer" %>
    </div>
  </div>
<% end %>
