<%# locals: (user_meal:) %>
<div id="time-edit-form-<%= user_meal.id %>">
  <%= form_with model: user_meal, url: user_meal_path(user_meal), method: :patch, local: true do |f| %>
    <% if user_meal.errors.any? %>
      <p class="text-red-600 dark:text-red-400 text-sm mb-3"><%= user_meal.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex items-center gap-3 mb-4">
      <div class="w-16 h-16 rounded overflow-hidden flex-shrink-0">
        <%= meal_image_tag(user_meal.meal, size: :small) %>
      </div>
      <div class="min-w-0">
        <h3 class="text-lg font-semibold dark:text-dark-text">Edit time</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1"><%= user_meal.meal&.meal_name || "Meal" %></p>
      </div>
    </div>
    <%= f.datetime_local_field :consumed_at,
        value: user_meal.consumed_at&.in_time_zone&.strftime("%Y-%m-%dT%H:%M"),
        required: true,
        data: { time_modal_target: "field" },
        class: "border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-dark-text rounded p-2 w-full" %>
    <div class="flex justify-end gap-2 mt-4">
      <button type="button" data-action="time-modal#close" class="px-4 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded">Cancel</button>
      <button type="submit" class="border-0 bg-transparent p-0">
        <%= render "shared/aqua_style", text: "Save" %>
      </button>
    </div>
  <% end %>
</div>
