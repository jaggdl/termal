<%= turbo_stream_from Current.user, "user_meals" %>

<%= render "shared/search_bar" %>

<div class="flex flex-col w-full space-y-6">
  <div class="flex w-full flex-col space-y-4">
    <div class="flex md:flex-row flex-col space-x-4 justify-between items-center">
      <div class="flex justify-between items-center space-x-2">
        <%= link_to user_meals_path(date: (@date - 1).to_s), class: "group relative inline-flex items-center justify-center w-10 h-10 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2", title: "Previous day" do %>
          <%= render partial: "shared/arrow_button", locals: { direction: "left", disabled: false } %>
        <% end %>

        <h2 class="font-semibold w-24 text-center">
          <% date_string = case @date
          when @today
            "Today"
          when @yesterday
            "Yesterday"
          else
            @date.strftime("%B %d, %Y")
          end %>
          <%= date_string %>
        </h2>

        <% if @date < @today %>
          <%= link_to user_meals_path(date: (@date + 1).to_s), class: "group relative inline-flex items-center justify-center w-10 h-10 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2", title: "Next day" do %>
            <%= render partial: "shared/arrow_button", locals: { direction: "right", disabled: false } %>
          <% end %>
        <% else %>
          <span class="relative inline-flex items-center justify-center w-10 h-10 cursor-not-allowed">
            <%= render partial: "shared/arrow_button", locals: { direction: "right", disabled: true } %>
          </span>
        <% end %>
      </div>
      <%= render partial: "shared/nutrient_meters", locals: { user_meals: @meals_by_day[@date], date: @date, user_profile: Current.user_profile } %>
    </div>

    <% if @meals_by_day[@date].any? %>
      <div class="w-full">
        <ul id="user-meals-<%= @date.to_s %>">
          <% @meals_by_day[@date].each do |user_meal| %>
            <%= render user_meal %>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p>No meals for this day.</p>
    <% end %>
  </div>
</div>
